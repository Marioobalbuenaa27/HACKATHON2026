# Entorno de tests (Vitest). Copiar a apps/web/.env.test y completar.
#
# Base de datos: un schema AISLADO del proyecto Supabase (sin Docker, decisión de stack).
# Se usa la conexión directa (5432) para todo; los tests no son serverless.
# Preparar una vez:  pnpm test:db:setup   (corre las migraciones en el schema `turnero_test`)
DATABASE_URL="postgresql://postgres.<PROJECT_REF>:<PASSWORD>@aws-0-<REGION>.pooler.supabase.com:5432/postgres?schema=turnero_test"
DIRECT_URL="postgresql://postgres.<PROJECT_REF>:<PASSWORD>@aws-0-<REGION>.pooler.supabase.com:5432/postgres?schema=turnero_test"

# Cualquier string estable sirve para los tests.
AUTH_SECRET="test-secret-turnero-0000000000000000000000000000"
NODE_ENV="test"
SEED_ALLOW_PROD="false"
TZ="America/Argentina/Buenos_Aires"
