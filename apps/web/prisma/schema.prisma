// Esquema de datos — Turnero JP, Fase 1 (Núcleo administrativo).
// Contrato: docs/specs/fase-1-nucleo-administrativo.md (sección Data Models).
//
// Convenciones:
// - id: cuid() PK inmutable.
// - createdAt / updatedAt en todas las tablas salvo Auditoria (solo timestamp, inmutable).
// - Borrado: soft delete por campo `activo` en catálogos; hard delete permitido solo
//   en FranjaAgenda, ExcepcionAgenda y Slot (estado DISPONIBLE).
// - Unicidad case-insensitive de nombres: se normaliza en la capa de aplicación
//   (lower-case en la comparación de escritura) + índice único simple aquí.
// - Timestamps en UTC; presentación en America/Argentina/Buenos_Aires.

generator client {
  provider = "prisma-client-js"
}

// Base de datos: PostgreSQL gestionado en Supabase.
// - DATABASE_URL -> pooler de Supabase (PgBouncer, puerto 6543, `?pgbouncer=true`).
//   Lo usa el cliente Prisma en runtime.
// - DIRECT_URL   -> conexión directa (puerto 5432). La usan `prisma migrate` y
//   `prisma db push`, que no funcionan a través del pooler transaccional.
datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Rol {
  ADMIN
  COORDINACION
  RECEPCION
  PROFESIONAL
}

enum PrioridadBase {
  NORMAL
  PREFERENCIAL
  PRIORITARIO
}

enum DiaSemana {
  LUNES
  MARTES
  MIERCOLES
  JUEVES
  VIERNES
  SABADO
  DOMINGO
}

enum TipoExcepcion {
  BLOQUEO
  APERTURA
}

enum EstadoSlot {
  DISPONIBLE
  BLOQUEADO
  OCUPADO
  // Fase 2/3 añaden RESERVADO_TEMPORAL, OCUPADO
}

enum PrioridadOperativa {
  NORMAL
  PREFERENCIAL
  PRIORITARIO
  URGENTE
}

enum EstadoTurno {
  CONFIRMADO
  PRESENTE
  AUSENTE
  ATENDIDO
  CANCELADO
  A_REPROGRAMAR
  REPROGRAMADO_PENDIENTE_CONFIRMACION
}

enum TipoTurno {
  NORMAL
  SOBRETURNO
}

enum EstadoCasoReprogramacion {
  PENDIENTE
  RESUELTO
}

enum TipoEventoNotificable {
  REPROGRAMACION_INICIADA
  TURNO_REPROGRAMADO
  SOBRETURNO_CREADO
  CAMBIO_ESTADO_TURNO
}

enum EstadoEventoNotificable {
  PENDIENTE
  ENTREGADO
  FALLIDO
}

enum OrigenSlot {
  FRANJA
  APERTURA
}

enum DisparadorCorrida {
  JOB
  MANUAL
  INCREMENTAL
}

enum EstadoCorrida {
  OK
  SALTADA
  ERROR
}

enum AccionAuditada {
  CREAR
  EDITAR
  ELIMINAR
  DESACTIVAR
  ACTIVAR
  RESET_PASSWORD
  CREAR_TURNO
  CAMBIAR_ESTADO_TURNO
  CREAR_SOBRETURNO
  OVERRIDE_SOBRETURNO
  MARCAR_AUSENCIA_PROFESIONAL
  REPROGRAMAR_TURNO
}

enum EntidadAuditada {
  usuario
  franja
  excepcion
  parametros
  turno
  demanda_espontanea
  ausencia_profesional
  caso_reprogramacion
}

/// Personal del panel. El ciudadano no tiene cuenta (fuera de Fase 1).
model Usuario {
  id                    String   @id @default(cuid())
  nombre                String
  email                 String   @unique
  passwordHash          String
  rol                   Rol
  activo                Boolean  @default(true)
  passwordActualizadaAt DateTime @default(now())
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  profesional      Profesional?
  corridasLanzadas CorridaGeneracion[]
  accionesAuditadas Auditoria[]
  ausenciasMarcadas AusenciaProfesionalDia[] @relation("ausencia_marcada_por")

  @@index([rol])
  @@map("usuario")
}

model Especialidad {
  id               String   @id @default(cuid())
  nombre           String   @unique
  duracionTurnoMin Int // 5..120, múltiplo de 5 (validado en app)
  activa           Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  profesionales ProfesionalEspecialidad[]
  categorias    CategoriaEspecialidad[]
  franjas       FranjaAgenda[]
  excepciones   ExcepcionAgenda[]
  slots         Slot[]
  turnos        Turno[]

  @@map("especialidad")
}

model Profesional {
  id        String   @id @default(cuid())
  nombre    String
  apellido  String
  matricula String   @unique
  usuarioId String?  @unique
  activo    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  usuario       Usuario?                  @relation(fields: [usuarioId], references: [id])
  especialidades ProfesionalEspecialidad[]
  franjas       FranjaAgenda[]
  excepciones   ExcepcionAgenda[]
  slots         Slot[]
  turnos        Turno[]
  ausenciasDia  AusenciaProfesionalDia[]

  @@map("profesional")
}

model ProfesionalEspecialidad {
  profesionalId  String
  especialidadId String

  profesional  Profesional  @relation(fields: [profesionalId], references: [id], onDelete: Cascade)
  especialidad Especialidad @relation(fields: [especialidadId], references: [id], onDelete: Cascade)

  @@id([profesionalId, especialidadId])
  @@index([especialidadId])
  @@map("profesional_especialidad")
}

model CategoriaProblema {
  id              String        @id @default(cuid())
  nombre          String        @unique
  ayuda           String?
  prioridadBase   PrioridadBase @default(NORMAL)
  derivarAGuardia Boolean       @default(false)
  orden           Int           @default(0)
  activa          Boolean       @default(true)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  especialidades CategoriaEspecialidad[]
  turnos         Turno[]
  demandas       DemandaEspontanea[]

  @@index([orden])
  @@map("categoria_problema")
}

model CategoriaEspecialidad {
  categoriaId    String
  especialidadId String
  nota           String? @db.VarChar(280)

  categoria    CategoriaProblema @relation(fields: [categoriaId], references: [id], onDelete: Cascade)
  especialidad Especialidad      @relation(fields: [especialidadId], references: [id], onDelete: Cascade)

  @@id([categoriaId, especialidadId])
  @@index([especialidadId])
  @@map("categoria_especialidad")
}

model Sala {
  id            String   @id @default(cuid())
  identificador String   @unique
  ubicacion     String?
  activa        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  franjas     FranjaAgenda[]
  excepciones ExcepcionAgenda[]
  slots       Slot[]
  turnos      Turno[]

  @@map("sala")
}

model ObraSocial {
  id        String   @id @default(cuid())
  nombre    String   @unique
  activa    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("obra_social")
}

/// Franja horaria semanal recurrente de la agenda de un profesional.
model FranjaAgenda {
  id             String    @id @default(cuid())
  profesionalId  String
  diaSemana      DiaSemana
  horaInicio     String // "HH:MM" 24h, mismo día
  horaFin        String
  especialidadId String
  salaId         String
  vigenciaDesde  DateTime  @db.Date
  vigenciaHasta  DateTime? @db.Date
  activa         Boolean   @default(true)
  inconsistente  Boolean   @default(false)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  profesional  Profesional  @relation(fields: [profesionalId], references: [id])
  especialidad Especialidad @relation(fields: [especialidadId], references: [id])
  sala         Sala         @relation(fields: [salaId], references: [id])

  @@index([profesionalId, diaSemana])
  @@index([profesionalId, activa])
  @@map("franja_agenda")
}

/// Excepción puntual: BLOQUEO (no atiende) o APERTURA (atiende fuera de franja).
model ExcepcionAgenda {
  id             String        @id @default(cuid())
  profesionalId  String
  fecha          DateTime      @db.Date
  tipo           TipoExcepcion
  horaInicio     String? // null => bloqueo de día completo; obligatorio si APERTURA
  horaFin        String?
  especialidadId String? // obligatorio si APERTURA
  salaId         String?
  motivo         String        @db.VarChar(280)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  profesional  Profesional   @relation(fields: [profesionalId], references: [id])
  especialidad Especialidad? @relation(fields: [especialidadId], references: [id])
  sala         Sala?         @relation(fields: [salaId], references: [id])

  @@index([profesionalId, fecha])
  @@map("excepcion_agenda")
}

/// Slot atómico generado a partir de franjas/excepciones. Sobre él operan Fase 2 y 3.
model Slot {
  id             String     @id @default(cuid())
  profesionalId  String
  especialidadId String
  salaId         String
  fecha          DateTime   @db.Date
  horaInicio     String
  horaFin        String
  inicioUtc      DateTime
  finUtc         DateTime
  estado         EstadoSlot @default(DISPONIBLE)
  origen         OrigenSlot
  origenId       String
  huerfano       Boolean    @default(false)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  profesional  Profesional  @relation(fields: [profesionalId], references: [id])
  especialidad Especialidad @relation(fields: [especialidadId], references: [id])
  sala         Sala         @relation(fields: [salaId], references: [id])
  turno        Turno?
  // `origenId` es polimórfico (FranjaAgenda | ExcepcionAgenda según `origen`).
  // Prisma no soporta relaciones polimórficas: se resuelve en la capa de aplicación.

  @@unique([profesionalId, fecha, horaInicio], name: "slot_unico_por_profesional")
  @@index([profesionalId, fecha])
  @@index([fecha, estado])
  @@index([origen, origenId])
  @@map("slot")
}

/// Turno operativo creado por personal del hospital o por futuros canales ciudadanos.
model Turno {
  id                    String             @id @default(cuid())
  slotId                String?            @unique
  profesionalId         String
  especialidadId        String
  salaId                String?
  categoriaId           String
  fecha                 DateTime           @db.Date
  horaProgramada        String?
  horaLlegada           DateTime?
  tipo                  TipoTurno          @default(NORMAL)
  prioridad             PrioridadOperativa @default(NORMAL)
  estado                EstadoTurno        @default(CONFIRMADO)
  pacienteNombre        String             @db.VarChar(160)
  pacienteDni           String             @db.VarChar(16)
  pacienteNacimiento    DateTime           @db.Date
  responsableNombre     String             @db.VarChar(160)
  responsableDni        String?            @db.VarChar(16)
  responsableVinculo    String             @db.VarChar(80)
  telefono              String?            @db.VarChar(32)
  email                 String?            @db.VarChar(254)
  presenteAt            DateTime?
  ausenteAt             DateTime?
  atendidoAt            DateTime?
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt

  slot          Slot?               @relation(fields: [slotId], references: [id])
  profesional   Profesional          @relation(fields: [profesionalId], references: [id])
  especialidad  Especialidad         @relation(fields: [especialidadId], references: [id])
  sala          Sala?                @relation(fields: [salaId], references: [id])
  categoria     CategoriaProblema    @relation(fields: [categoriaId], references: [id])
  demanda       DemandaEspontanea?
  casosOrigen   CasoReprogramacion[] @relation("turno_origen")
  casosDestino  CasoReprogramacion[] @relation("turno_destino")
  eventos       EventoNotificable[]

  @@index([fecha, estado])
  @@index([profesionalId, fecha])
  @@index([pacienteDni, especialidadId, estado])
  @@map("turno")
}

model DemandaEspontanea {
  id                  String             @id @default(cuid())
  turnoId             String?            @unique
  categoriaId         String
  prioridadSugerida   PrioridadOperativa
  prioridadConfirmada PrioridadOperativa
  respuestas          Json
  motivoAjuste        String?            @db.VarChar(280)
  derivadaAGuardia    Boolean            @default(false)
  horaLlegada         DateTime           @default(now())
  createdAt           DateTime           @default(now())

  turno     Turno?             @relation(fields: [turnoId], references: [id])
  categoria CategoriaProblema @relation(fields: [categoriaId], references: [id])

  @@index([horaLlegada])
  @@index([prioridadConfirmada])
  @@map("demanda_espontanea")
}

model AusenciaProfesionalDia {
  id            String   @id @default(cuid())
  profesionalId String
  fecha         DateTime @db.Date
  motivo        String   @db.VarChar(280)
  marcadaPorId  String
  createdAt     DateTime @default(now())

  profesional Profesional @relation(fields: [profesionalId], references: [id])
  marcadaPor  Usuario     @relation("ausencia_marcada_por", fields: [marcadaPorId], references: [id])

  @@unique([profesionalId, fecha])
  @@map("ausencia_profesional_dia")
}

model CasoReprogramacion {
  id             String                   @id @default(cuid())
  turnoOrigenId  String
  turnoDestinoId String?                  @unique
  estado         EstadoCasoReprogramacion @default(PENDIENTE)
  motivo         String                   @db.VarChar(280)
  resueltoPorId  String?
  createdAt      DateTime                 @default(now())
  resueltoAt     DateTime?

  turnoOrigen  Turno  @relation("turno_origen", fields: [turnoOrigenId], references: [id])
  turnoDestino Turno? @relation("turno_destino", fields: [turnoDestinoId], references: [id])

  @@index([estado])
  @@map("caso_reprogramacion")
}

model EventoNotificable {
  id           String                   @id @default(cuid())
  turnoId      String
  tipo         TipoEventoNotificable
  destinatario String                   @db.VarChar(254)
  payload      Json
  estado       EstadoEventoNotificable @default(PENDIENTE)
  createdAt    DateTime                 @default(now())
  procesadoAt  DateTime?

  turno Turno @relation(fields: [turnoId], references: [id])

  @@index([estado, createdAt])
  @@map("evento_notificable")
}

/// Parámetros del sistema. Filas fijas, solo se edita `valor`.
model ParametroSistema {
  clave     String   @id
  valor     Int
  updatedAt DateTime @updatedAt

  @@map("parametro_sistema")
}

model CorridaGeneracion {
  id            String            @id @default(cuid())
  disparador    DisparadorCorrida
  actorId       String?
  profesionalId String? // null => todos
  creados       Int               @default(0)
  eliminados    Int               @default(0)
  sinCambios    Int               @default(0)
  estado        EstadoCorrida
  detalle       String?
  iniciadaAt    DateTime          @default(now())
  finalizadaAt  DateTime?

  actor Usuario? @relation(fields: [actorId], references: [id])

  @@index([iniciadaAt])
  @@map("corrida_generacion")
}

/// Log de auditoría inmutable. Sin UPDATE ni DELETE desde la aplicación.
model Auditoria {
  id        String          @id @default(cuid())
  actorId   String
  accion    AccionAuditada
  entidad   EntidadAuditada
  entidadId String
  motivo    String?         @db.VarChar(280)
  antes     Json?
  despues   Json?
  timestamp DateTime        @default(now())

  actor Usuario @relation(fields: [actorId], references: [id])

  @@index([entidad, timestamp])
  @@index([actorId, timestamp])
  @@map("auditoria")
}
