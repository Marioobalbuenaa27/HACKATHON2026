# Copiar a apps/web/.env y ajustar según entorno.

# Base de datos (coincide con docker-compose.yml para desarrollo local)
DATABASE_URL="postgresql://turnero:turnero@localhost:5432/turnero_jp?schema=public"

# Auth.js (NextAuth v5). Generar con: openssl rand -base64 32
AUTH_SECRET="cambiar-en-cada-entorno"

# Guard del seed: el seed aborta si NODE_ENV=production y SEED_ALLOW_PROD != "true"
# SEED_ALLOW_PROD="false"

# Zona horaria de presentación
TZ="America/Argentina/Buenos_Aires"
