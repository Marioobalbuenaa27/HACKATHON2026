# Copiar a apps/web/.env y ajustar según entorno.
# Prisma lee apps/web/.env (no la raíz).

# --- Base de datos: PostgreSQL gestionado en Supabase ---
# Dashboard de Supabase -> Project Settings -> Database -> Connection string.
#
# DATABASE_URL: usar el connection pooler (Transaction mode, puerto 6543) + "?pgbouncer=true".
#   Es la URL que usa el cliente Prisma en runtime (serverless-friendly).
# DIRECT_URL: usar la conexión directa (Session mode, puerto 5432).
#   La usan `prisma migrate` y `prisma db push`; no funcionan sobre el pooler transaccional.
DATABASE_URL="postgresql://postgres.<PROJECT_REF>:<PASSWORD>@aws-0-<REGION>.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.<PROJECT_REF>:<PASSWORD>@aws-0-<REGION>.pooler.supabase.com:5432/postgres"

# --- Supabase (cliente JS, opcional; Prisma no lo necesita) ---
SUPABASE_URL="https://<PROJECT_REF>.supabase.co"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_xxx"

# --- Auth.js (NextAuth v5). Generar con: openssl rand -base64 32 ---
AUTH_SECRET="cambiar-en-cada-entorno"

# --- Job de generación de slots (FR-39a) ---
# Secreto compartido que el scheduler manda en `Authorization: Bearer <valor>`.
# Vercel Cron lo adjunta solo si esta env var existe en el proyecto.
# Generar con: openssl rand -base64 32
CRON_SECRET="cambiar-en-cada-entorno"

# --- Entorno / seed ---
# El seed aborta si NODE_ENV=production y SEED_ALLOW_PROD != "true"
NODE_ENV="development"
# SEED_ALLOW_PROD="false"

# --- Zona horaria de presentación ---
TZ="America/Argentina/Buenos_Aires"
